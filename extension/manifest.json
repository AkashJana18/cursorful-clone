{
  "manifest_version": 3,
  "name": "Cursorful Studio: click companion",
  "version": "0.1.0",
  "description": "Sends click positions from the tab you record to the local studio, so zooms can be placed automatically.",
  "permissions": [
    "scripting",
    "activeTab",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Start a click capture session",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon48.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
